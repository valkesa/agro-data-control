rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userData() {
      return get(userDoc()).data;
    }

    function hasUserContext() {
      return signedIn()
        && exists(userDoc())
        && userData().active == true;
    }

    function isUserActiveTenant(tenantId) {
      return hasUserContext() && userData().activeTenantId == tenantId;
    }

    function memberDoc(tenantId) {
      return /databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid);
    }

    function membershipData(tenantId) {
      return get(memberDoc(tenantId)).data;
    }

    function isTenantMember(tenantId) {
      return isUserActiveTenant(tenantId)
        && exists(memberDoc(tenantId))
        && membershipData(tenantId).active == true;
    }

    function memberRole(tenantId) {
      return membershipData(tenantId).role;
    }

    // Returns true if the current user is an active tenant_admin of the given tenant.
    function isTenantAdmin(tenantId) {
      return isTenantMember(tenantId) && memberRole(tenantId) == 'tenant_admin';
    }

    // A tenant_admin may write a members/{uid} document only when:
    //   - they are active tenant_admin of this tenant
    //   - they are not modifying their own record
    //   - the resulting role is strictly 'tenant_operator' (no escalation)
    function canTenantAdminWriteMember(tenantId, targetUid) {
      return isTenantAdmin(tenantId)
        && request.auth.uid != targetUid
        && request.resource.data.role == 'tenant_operator';
    }

    // tenant_admin can edit site-level config; owner always can.
    function canEditTenantConfig(tenantId) {
      return isTenantAdmin(tenantId);
    }

    function isOwner() {
      return hasUserContext() && userData().role == 'owner';
    }

    function isValkeTechnician(tenantId) {
      return hasUserContext()
        && userData().role == 'valke_technician'
        && userData().activeTenantId == tenantId;
    }

    function canReadTenant(tenantId) {
      return isTenantMember(tenantId) || isOwner() || isValkeTechnician(tenantId);
    }

    function allowedComparisonModules() {
      return [
        'Estado',
        'Ambiente',
        'Filtros',
        'Ventilacion',
        'Enfriamiento',
        'Aperturas',
        'Calefaccion',
        'Alarmas',
        'Amoniaco',
        'Agua',
        'EnergiaE',
        'Oee',
        'Produccion',
        'Cerdas'
      ];
    }

    function isValidComparisonModuleOrder(order) {
      return order is list
        && order.size() == allowedComparisonModules().size()
        && order.hasAll(allowedComparisonModules())
        && order.hasOnly(allowedComparisonModules());
    }

    function isValidVisibleUnits(ui) {
      return ui is map
        && ui.keys().hasOnly(['munters1', 'munters2'])
        && ui.munters1 is bool
        && ui.munters2 is bool;
    }

    function isValidManualFanUnit(unit) {
      return unit is map
        && unit.keys().hasOnly(['q5', 'q6', 'q7', 'q8', 'q9', 'q10'])
        && unit.q5 is bool
        && unit.q6 is bool
        && unit.q7 is bool
        && unit.q8 is bool
        && unit.q9 is bool
        && unit.q10 is bool;
    }

    function isValidManualFanStatus(status) {
      return status is map
        && status.keys().hasOnly(['munters1', 'munters2'])
        && isValidManualFanUnit(status.munters1)
        && isValidManualFanUnit(status.munters2);
    }

    function hasValidManualFanStatus() {
      return request.resource.data.ui is map
        && request.resource.data.ui.manualFanStatus is map
        && isValidManualFanStatus(request.resource.data.ui.manualFanStatus);
    }

    function isValidMaintenanceMode(mode) {
      return ['in_situ', 'systems', 'scheduled'].hasAny([mode]);
    }

    function isValidMaintenanceEntry(entry) {
      return isValidMaintenanceMode(entry)
        || (
          entry is map
          && entry.keys().hasOnly(['mode', 'expiresAt'])
          && isValidMaintenanceMode(entry.mode)
          && entry.expiresAt is timestamp
        );
    }

    function isValidLegacyMaintenanceSettings(settings) {
      return settings is map
        && settings.keys().hasOnly(['munters1', 'munters2'])
        && (
          !settings.keys().hasAny(['munters1'])
          || isValidMaintenanceEntry(settings.munters1)
        )
        && (
          !settings.keys().hasAny(['munters2'])
          || isValidMaintenanceEntry(settings.munters2)
        );
    }

    function isValidDeviceMaintenanceSettings(settings) {
      return settings is map
        && settings.keys().size() <= 100;
    }

    function isValidMaintenanceSettings(settings) {
      return isValidLegacyMaintenanceSettings(settings)
        || (
          settings is map
          && settings.keys().hasOnly(['legacy', 'devices'])
          && (
            !settings.keys().hasAny(['legacy'])
            || isValidLegacyMaintenanceSettings(settings.legacy)
          )
          && (
            !settings.keys().hasAny(['devices'])
            || isValidDeviceMaintenanceSettings(settings.devices)
          )
        );
    }

    function hasValidMaintenanceSettings() {
      return request.resource.data.ui is map
        && request.resource.data.ui.maintenance is map
        && isValidMaintenanceSettings(request.resource.data.ui.maintenance);
    }

    function isManualFanStatusCreate() {
      return request.resource.data.keys().hasOnly(['ui', 'updatedAt', 'updatedByUid'])
        && request.resource.data.ui.keys().hasOnly(['manualFanStatus'])
        && hasValidManualFanStatus();
    }

    function isManualFanStatusUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['ui', 'updatedAt', 'updatedByUid'])
        && hasValidManualFanStatus()
        && (
          (!('ui' in resource.data)
            && request.resource.data.ui.keys().hasOnly(['manualFanStatus']))
          || (
            resource.data.ui is map
            && request.resource.data.ui.diff(resource.data.ui).affectedKeys()
                .hasOnly(['manualFanStatus'])
          )
        );
    }

    function canWriteManualFanStatus(tenantId) {
      return isOwner() || isValkeTechnician(tenantId);
    }

    function canWriteAlertConfig(tenantId) {
      return isOwner() || isTenantAdmin(tenantId);
    }

    function isKnownAlertId(alertId) {
      return [
        'munters_door_open',
        'room_door_open',
        'sensor_failure',
        'temperature_interior',
        'high_temperature_heating_active',
        'low_temperature_humidifier_active',
        'high_differential_pressure',
        'high_humidity',
        'dew_point_risk'
      ].hasAny([alertId]);
    }

    function hasFunctionalAlertConfigOverride() {
      return request.resource.data.keys().hasAny([
        'enabled',
        'visualEnabled',
        'whatsappEnabled',
        'whatsappDelayMinutes',
        'thresholds',
        'cooldownMinutes',
        'order'
      ]);
    }

    function isValidAlertConfigThresholds(thresholds) {
      return thresholds is map
        && thresholds.keys().hasOnly([
          'min',
          'max',
          'threshold',
          'margin',
          'sensorFailureMin'
        ])
        && (
          !thresholds.keys().hasAny(['min'])
          || thresholds.min is number
        )
        && (
          !thresholds.keys().hasAny(['max'])
          || thresholds.max is number
        )
        && (
          !thresholds.keys().hasAny(['threshold'])
          || thresholds.threshold is number
        )
        && (
          !thresholds.keys().hasAny(['margin'])
          || thresholds.margin is number
        )
        && (
          !thresholds.keys().hasAny(['sensorFailureMin'])
          || thresholds.sensorFailureMin is number
        );
    }

    function isValidAlertConfigDocument() {
      return request.resource.data.keys().hasOnly([
          'schemaVersion',
          'enabled',
          'visualEnabled',
          'whatsappEnabled',
          'whatsappDelayMinutes',
          'thresholds',
          'cooldownMinutes',
          'order',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasAll([
          'schemaVersion',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.uid
        && hasFunctionalAlertConfigOverride()
        && (
          !request.resource.data.keys().hasAny(['createdAt'])
          || request.resource.data.createdAt is timestamp
        )
        && (
          !request.resource.data.keys().hasAny(['createdBy'])
          || request.resource.data.createdBy is string
        )
        && (
          !request.resource.data.keys().hasAny(['enabled'])
          || request.resource.data.enabled is bool
        )
        && (
          !request.resource.data.keys().hasAny(['visualEnabled'])
          || request.resource.data.visualEnabled is bool
        )
        && (
          !request.resource.data.keys().hasAny(['whatsappEnabled'])
          || request.resource.data.whatsappEnabled is bool
        )
        && (
          !request.resource.data.keys().hasAny(['whatsappDelayMinutes'])
          || (
            request.resource.data.whatsappDelayMinutes is int
            && request.resource.data.whatsappDelayMinutes >= 0
          )
        )
        && (
          !request.resource.data.keys().hasAny(['cooldownMinutes'])
          || (
            request.resource.data.cooldownMinutes is int
            && request.resource.data.cooldownMinutes >= 0
          )
        )
        && (
          !request.resource.data.keys().hasAny(['order'])
          || (
            request.resource.data.order is int
            && request.resource.data.order >= 0
          )
        )
        && (
          !request.resource.data.keys().hasAny(['thresholds'])
          || isValidAlertConfigThresholds(request.resource.data.thresholds)
        );
    }

    function canReadAlertConfig(tenantId) {
      return canReadTenant(tenantId);
    }

    function canCreateAlertConfig(tenantId, alertId) {
      return canWriteAlertConfig(tenantId)
        && isKnownAlertId(alertId)
        && isValidAlertConfigDocument()
        && request.resource.data.keys().hasAll(['createdBy'])
        && request.resource.data.createdBy == request.auth.uid;
    }

    function canUpdateAlertConfig(tenantId, alertId) {
      return canWriteAlertConfig(tenantId)
        && isKnownAlertId(alertId)
        && isValidAlertConfigDocument()
        && (
          !request.resource.data.keys().hasAny(['createdAt'])
          || request.resource.data.createdAt == resource.data.createdAt
        )
        && (
          !request.resource.data.keys().hasAny(['createdBy'])
          || request.resource.data.createdBy == resource.data.createdBy
        );
    }

    function canDeleteAlertConfig(tenantId, alertId) {
      return canWriteAlertConfig(tenantId) && isKnownAlertId(alertId);
    }

    function canWriteAlertRecipient(tenantId) {
      return isOwner() || isTenantAdmin(tenantId);
    }

    function isValidAlertRecipientPhone(phone) {
      return phone is string
        && phone.size() >= 9
        && phone.size() <= 16
        && phone.matches('^\\+[0-9]+$');
    }

    function isValidAlertRecipientDocument() {
      return request.resource.data.keys().hasOnly([
          'schemaVersion',
          'displayName',
          'phoneE164',
          'enabled',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasAll([
          'schemaVersion',
          'displayName',
          'phoneE164',
          'enabled',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 120
        && isValidAlertRecipientPhone(request.resource.data.phoneE164)
        && request.resource.data.enabled is bool
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.uid
        && (
          !request.resource.data.keys().hasAny(['createdAt'])
          || request.resource.data.createdAt is timestamp
        )
        && (
          !request.resource.data.keys().hasAny(['createdBy'])
          || request.resource.data.createdBy is string
        );
    }

    function canCreateAlertRecipient(tenantId) {
      return canWriteAlertRecipient(tenantId)
        && isValidAlertRecipientDocument()
        && request.resource.data.keys().hasAll(['createdBy'])
        && request.resource.data.createdBy == request.auth.uid;
    }

    function canUpdateAlertRecipient(tenantId) {
      return canWriteAlertRecipient(tenantId)
        && isValidAlertRecipientDocument()
        && (
          !request.resource.data.keys().hasAny(['createdAt'])
          || request.resource.data.createdAt == resource.data.createdAt
        )
        && (
          !request.resource.data.keys().hasAny(['createdBy'])
          || request.resource.data.createdBy == resource.data.createdBy
        );
    }

    function canDeleteAlertRecipient(tenantId) {
      return canWriteAlertRecipient(tenantId);
    }

    function isMaintenanceCreate() {
      return request.resource.data.keys().hasOnly(['ui', 'updatedAt', 'updatedByUid'])
        && request.resource.data.ui.keys().hasOnly(['maintenance'])
        && hasValidMaintenanceSettings();
    }

    function isMaintenanceUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['ui', 'updatedAt', 'updatedByUid'])
        && hasValidMaintenanceSettings()
        && (
          (!('ui' in resource.data)
            && request.resource.data.ui.keys().hasOnly(['maintenance']))
          || (
            resource.data.ui is map
            && request.resource.data.ui.diff(resource.data.ui).affectedKeys()
                .hasOnly(['maintenance'])
          )
        );
    }

    function isValidOptionalNumber(field) {
      return !request.resource.data.keys().hasAny([field])
        || request.resource.data[field] is number;
    }

    function isValidElectricalCostSettings() {
      return request.resource.data.keys().hasOnly(['costPerKw', 'updatedAt', 'updatedBy'])
        && request.resource.data.costPerKw is number
        && request.resource.data.costPerKw >= 0
        && request.resource.data.updatedBy == request.auth.uid
        && (
          !('updatedAt' in request.resource.data)
          || request.resource.data.updatedAt is timestamp
        );
    }

    function isValidSiteProvisioningStatus(status) {
      return ['pending_backend', 'ready', 'error'].hasAny([status]);
    }

    function isValidElectricalConsumptionSettings() {
      return request.resource.data.keys().hasOnly([
          'fanLevels',
          'humidifierPumpKw',
          'heaterStage1Kw',
          'heaterStage2Kw',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.fanLevels is list
        && request.resource.data.fanLevels.size() <= 100
        && isValidOptionalNumber('humidifierPumpKw')
        && isValidOptionalNumber('heaterStage1Kw')
        && isValidOptionalNumber('heaterStage2Kw')
        && request.resource.data.updatedBy == request.auth.uid
        && (
          !('updatedAt' in request.resource.data)
          || request.resource.data.updatedAt is timestamp
        );
    }

    function isValidRoomWashEvent(tenantId) {
      return request.resource.data.keys().hasOnly([
          'tenantId',
          'roomId',
          'roomNumber',
          'muntersId',
          'washedAt',
          'createdAt',
          'createdByUid',
          'createdByName',
          'source'
        ])
        && request.resource.data.keys().hasAll([
          'tenantId',
          'roomId',
          'roomNumber',
          'muntersId',
          'washedAt',
          'createdAt',
          'createdByUid',
          'createdByName',
          'source'
        ])
        && request.resource.data.tenantId == tenantId
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() > 0
        && request.resource.data.source == 'operator'
        && request.resource.data.washedAt is timestamp
        && request.resource.data.createdAt is timestamp
        && (
          (
            request.resource.data.roomId == 'room_1'
            && request.resource.data.roomNumber == 1
            && request.resource.data.muntersId == 'munters1'
          )
          || (
            request.resource.data.roomId == 'room_2'
            && request.resource.data.roomNumber == 2
            && request.resource.data.muntersId == 'munters2'
          )
        );
    }

    // A user can switch their own active site, provided the new siteId is
    // already listed in their allowedSiteIds (prevents access to unlisted sites).
    function isOwnSiteSwitch(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['defaultSiteId'])
        && request.resource.data.defaultSiteId is string
        && resource.data.activeTenantId is string
        && resource.data.allowedSiteIds.hasAny([request.resource.data.defaultSiteId])
        && exists(/databases/$(database)/documents/tenants/$(resource.data.activeTenantId)/sites/$(request.resource.data.defaultSiteId));
    }

    function isOwnUiUpdate(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ui'])
        && request.resource.data.ui is map
        && request.resource.data.ui.keys().hasOnly(['comparison', 'visibleUnits'])
        && (
          !('comparison' in request.resource.data.ui)
          || (
            request.resource.data.ui.comparison is map
            && request.resource.data.ui.comparison.keys().hasOnly(['moduleOrder'])
            && isValidComparisonModuleOrder(request.resource.data.ui.comparison.moduleOrder)
          )
        )
        && (
          !('visibleUnits' in request.resource.data.ui)
          || isValidVisibleUnits(request.resource.data.ui.visibleUnits)
        );
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();

      // New users self-register with role='pending' and active=false.
      // Owner profiles are set directly in Firestore, never via client create.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'pending'
        && request.resource.data.active == false;

      // Owner can update profile fields managed by updateUserAccess().
      // Users can update only their own UI preferences.
      allow update: if (isOwner()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['role', 'activeTenantId', 'defaultSiteId', 'allowedSiteIds',
                        'active', 'updatedAt', 'email']))
        || isOwnUiUpdate(uid)
        || isOwnSiteSwitch(uid);

      allow delete: if false;
    }

    // Etapa 6A: global, not tenant-scoped — room_climate/laboratory_basic/
    // disinfection_arch are reusable presentation types shared across every
    // tenant. Read: any authenticated app user. Write: owner-only, same as
    // every other structural/config collection in this file (sites,
    // sectors, devices) — there is no template-editor UI yet, but writes
    // are already gated for when one exists. Never physically deleted,
    // consistent with every other collection here.
    match /deviceTemplates/{templateId} {
      allow read: if hasUserContext();
      allow create, update: if isOwner();
      allow delete: if false;
    }

    // Etapa N7.1 §1/§2/§4/§16: global, not tenant-scoped design-time config
    // (LayoutTemplate/CellLayoutPreset/CapabilityMetric/CapabilityIndicator/
    // CapabilityProfile/BoardPreset) — same rationale and same read/write
    // shape as `deviceTemplates` above: reusable across every tenant, read
    // by any authenticated app user, write owner-only. Field-by-field
    // validation intentionally stays at the top-level document shape (not
    // a recursive re-implementation of each model's own constructor
    // validation) — every one of these documents is only ever written
    // through its matching Repository class
    // (`lib/services/*_repository.dart`), never directly from a widget
    // (N7.1 §4), so the model's own validating `fromMap`/constructor is
    // what actually runs before any write is even attempted.
    match /layoutTemplates/{templateId} {
      allow read: if hasUserContext();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'columns', 'rows', 'schemaVersion', 'templateVersion',
          'enabled', 'createdAt', 'updatedAt', 'internalUnitsPerCellX',
          'internalUnitsPerCellY'
        ])
        && request.resource.data.id == templateId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.columns is int
        && request.resource.data.rows is int
        && request.resource.data.schemaVersion is int
        && request.resource.data.templateVersion is int
        && request.resource.data.enabled is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /cellLayoutPresets/{presetId} {
      allow read: if hasUserContext();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'widthCells', 'heightCells', 'schemaVersion',
          'presetVersion', 'enabled', 'elements', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == presetId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.widthCells is int
        && request.resource.data.heightCells is int
        && request.resource.data.schemaVersion is int
        && request.resource.data.presetVersion is int
        && request.resource.data.enabled is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /capabilityMetrics/{metricKey} {
      allow read: if hasUserContext();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly([
          'key', 'label', 'shortLabel', 'defaultUnit', 'icon', 'displayType',
          'decimals', 'statusBehavior', 'schemaVersion', 'enabled',
          'recordVersion', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.key == metricKey
        && request.resource.data.label is string
        && request.resource.data.label.size() > 0
        && request.resource.data.schemaVersion is int
        && request.resource.data.recordVersion is int
        && request.resource.data.enabled is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /capabilityIndicators/{indicatorKey} {
      allow read: if hasUserContext();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly([
          'key', 'label', 'defaultIcon', 'schemaVersion', 'enabled',
          'recordVersion', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.key == indicatorKey
        && request.resource.data.label is string
        && request.resource.data.label.size() > 0
        && request.resource.data.schemaVersion is int
        && request.resource.data.recordVersion is int
        && request.resource.data.enabled is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /capabilityProfiles/{profileId} {
      allow read: if hasUserContext();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'description', 'enabled', 'metricKeys',
          'indicatorKeys', 'metricBindings', 'indicatorBindings',
          'suggestedIndicatorsByMetric', 'profileVersion', 'createdAt',
          'updatedAt'
        ])
        && request.resource.data.id == profileId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.enabled is bool
        && request.resource.data.profileVersion is int
        && request.resource.data.metricKeys is list
        && request.resource.data.indicatorKeys is list
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    // Unlike every other N7.1 global collection above, a BoardPreset can
    // actually be deleted (N7.1 §10) — deleting it never cascades: a
    // Device that already applied it keeps its own
    // `tenants/{tenantId}/devices/{deviceId}/settings/boardConfig`
    // document completely untouched (that document is a deep, independent
    // copy — never a live reference into this collection).
    match /boardPresets/{presetId} {
      allow read: if hasUserContext();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'description', 'layoutTemplateId', 'showTitleDefault',
          'titleOverride', 'items', 'requiredMetricKeys', 'optionalMetricKeys',
          'capabilityProfileId', 'schemaVersion', 'presetVersion', 'enabled',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == presetId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.layoutTemplateId is string
        && request.resource.data.layoutTemplateId.size() > 0
        && request.resource.data.items is list
        && request.resource.data.schemaVersion is int
        && request.resource.data.presetVersion is int
        && request.resource.data.enabled is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isOwner();
    }

    function isValidPresenceDoc(uid) {
      return request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'role',
          'lastSeenAt',
          'activeSince',
          'currentSessionId',
          'platform',
          'isOnline',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'role',
          'lastSeenAt',
          'isOnline',
          'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.email is string
        && request.resource.data.role is string
        && request.resource.data.isOnline is bool
        && request.resource.data.lastSeenAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (
          !('currentSessionId' in request.resource.data)
          || request.resource.data.currentSessionId is string
        )
        && (
          !('platform' in request.resource.data)
          || request.resource.data.platform is string
        )
        && (
          !('activeSince' in request.resource.data)
          || request.resource.data.activeSince is timestamp
        );
    }

    function isValidSessionReason(reason) {
      return ['', 'manual_logout', 'inactivity_timeout', 'session_replaced']
        .hasAny([reason]);
    }

    function isValidUserSessionDoc(sessionId) {
      return request.resource.data.keys().hasOnly([
          'sessionId',
          'uid',
          'displayName',
          'email',
          'role',
          'loginAt',
          'activeSince',
          'lastSeenAt',
          'closedAt',
          'closeReason',
          'activeDurationSeconds',
          'isActive',
          'platform',
          'userAgent',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'sessionId',
          'uid',
          'displayName',
          'email',
          'role',
          'loginAt',
          'activeSince',
          'lastSeenAt',
          'closeReason',
          'isActive',
          'platform',
          'userAgent',
          'updatedAt'
        ])
        && request.resource.data.sessionId == sessionId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.email is string
        && request.resource.data.role is string
        && request.resource.data.loginAt is timestamp
        && request.resource.data.activeSince is timestamp
        && request.resource.data.lastSeenAt is timestamp
        && request.resource.data.closeReason is string
        && isValidSessionReason(request.resource.data.closeReason)
        && request.resource.data.isActive is bool
        && request.resource.data.platform is string
        && request.resource.data.userAgent is string
        && request.resource.data.updatedAt is timestamp
        && (
          !('createdAt' in request.resource.data)
          || request.resource.data.createdAt is timestamp
        )
        && (
          !('closedAt' in request.resource.data)
          || request.resource.data.closedAt == null
          || request.resource.data.closedAt is timestamp
        )
        && (
          !('activeDurationSeconds' in request.resource.data)
          || request.resource.data.activeDurationSeconds == null
          || request.resource.data.activeDurationSeconds is int
        );
    }

    match /workspaces/{workspaceId}/presence/{uid} {
      allow get: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow list: if isOwner();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && isValidPresenceDoc(uid);
      allow delete: if false;
    }

    match /workspaces/{workspaceId}/userSessions/{sessionId} {
      allow get, list: if isOwner()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if signedIn()
        && isValidUserSessionDoc(sessionId);
      allow delete: if false;
    }

    match /tenants/{tenantId} {
      allow list: if isOwner();
      allow read: if canReadTenant(tenantId);
      allow create: if isOwner()
        && request.resource.data.keys()
          .hasOnly([
            'name',
            'clientName',
            'active',
            'createdByUid',
            'createdByEmail',
            'createdAt',
            'updatedAt'
          ])
        && request.resource.data.keys()
          .hasAll(['name', 'active', 'createdByUid', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && (
          !('clientName' in request.resource.data)
          || request.resource.data.clientName is string
        )
        && request.resource.data.active is bool
        && request.resource.data.active == true
        && request.resource.data.createdByUid is string
        && request.resource.data.createdByUid == request.auth.uid
        && (
          !('createdByEmail' in request.resource.data)
          || request.resource.data.createdByEmail is string
        )
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      // Owner-only, name/active/updatedAt only. tenant_admin does NOT get
      // this permission (tenant metadata edits stay owner-scoped, same as
      // sites/sectors/devices below). tenantId itself is the document path
      // segment (immutable by construction); createdByUid/createdByEmail/
      // createdAt are excluded from the allowlist so `diff().affectedKeys()`
      // rejects any attempt to change them.
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'active', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && (
          !('active' in request.resource.data)
          || request.resource.data.active is bool
        )
        && (
          !('updatedAt' in request.resource.data)
          || request.resource.data.updatedAt is timestamp
        );

      allow delete: if false;

      match /alertConfig/{alertId} {
        allow get: if canReadAlertConfig(tenantId) && isKnownAlertId(alertId);
        allow list: if canReadAlertConfig(tenantId);
        allow create: if canCreateAlertConfig(tenantId, alertId);
        allow update: if canUpdateAlertConfig(tenantId, alertId);
        allow delete: if canDeleteAlertConfig(tenantId, alertId);
      }

      match /alertRecipients/{recipientId} {
        allow get, list: if canReadTenant(tenantId);
        allow create: if canCreateAlertRecipient(tenantId);
        allow update: if canUpdateAlertRecipient(tenantId);
        allow delete: if canDeleteAlertRecipient(tenantId);
      }

      match /members/{uid} {
        // A tenant_admin can read all members in their own tenant.
        allow get: if (signedIn() && request.auth.uid == uid && isUserActiveTenant(tenantId))
          || isOwner()
          || isTenantAdmin(tenantId);
        allow list: if isOwner() || isTenantAdmin(tenantId);

        // Owner: unrestricted writes.
        // tenant_admin: can only create a new tenant_operator (not tenant_admin, not owner).
        allow create: if isOwner()
          || canTenantAdminWriteMember(tenantId, uid);

        // Owner: unrestricted updates.
        // tenant_admin: can only update a tenant_operator record (resource.data.role
        //   is the existing role; blocks modifying other admins).
        allow update: if isOwner()
          || (canTenantAdminWriteMember(tenantId, uid)
              && resource.data.role == 'tenant_operator');

        allow delete: if false;
      }

      match /sites/{siteId} {
        allow read: if canReadTenant(tenantId);

        // New structural schema: description/enabled are additive fields
        // for the AgroSite model (lib/models/agro_site.dart). They coexist
        // with legacy fields (technicalId/backendUrl/active) already
        // present on existing site documents — this rule never restricts
        // the document to ONLY these keys, so legacy fields are untouched.
        //
        // createdAt is set once on create and is intentionally excluded
        // from the update allowlist below, making it immutable afterwards.
        allow update: if isOwner()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'description', 'enabled', 'provisioningStatus', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && (
            !('description' in request.resource.data)
            || request.resource.data.description is string
          )
          && (
            !('enabled' in request.resource.data)
            || request.resource.data.enabled is bool
          )
          && (
            !('provisioningStatus' in request.resource.data)
            || (
              request.resource.data.provisioningStatus is string
              && isValidSiteProvisioningStatus(request.resource.data.provisioningStatus)
            )
          )
          && (
            !('updatedAt' in request.resource.data)
            || request.resource.data.updatedAt is timestamp
          );

        // Creating a brand new site from the owner UI uses only the current
        // AgroSite payload. Do not add legacy `technicalId`, `backendUrl` or
        // `active` fields to this branch.
        allow create: if isOwner()
          && request.resource.data.keys()
              .hasOnly([
                'name',
                'description',
                'enabled',
                'provisioningStatus',
                'createdAt',
                'updatedAt'
              ])
          && request.resource.data.keys().hasAll([
                'name',
                'description',
                'enabled',
                'provisioningStatus',
                'createdAt',
                'updatedAt'
              ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.description is string
          && request.resource.data.enabled is bool
          && request.resource.data.provisioningStatus is string
          && request.resource.data.provisioningStatus == 'pending_backend'
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;

        allow delete: if false;

        match /alertConfig/{alertId} {
          allow get: if canReadAlertConfig(tenantId) && isKnownAlertId(alertId);
          allow list: if canReadAlertConfig(tenantId);
          allow create: if canCreateAlertConfig(tenantId, alertId);
          allow update: if canUpdateAlertConfig(tenantId, alertId);
          allow delete: if canDeleteAlertConfig(tenantId, alertId);
        }

        match /alertRecipients/{recipientId} {
          allow get, list: if canReadTenant(tenantId);
          allow create: if canCreateAlertRecipient(tenantId);
          allow update: if canUpdateAlertRecipient(tenantId);
          allow delete: if canDeleteAlertRecipient(tenantId);
        }

        // LEGACY ONLY:
        // This path is preserved exclusively for existing tenants.
        // New tenants and new features must use tenant-level `devices` and
        // `sectors`. Do not extend this branch for new implementations.
        match /plcs/{plcId} {
          allow read: if canReadTenant(tenantId);
          allow create, update: if isOwner()
            && request.resource.data.technicalId == plcId
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() > 0
            && request.resource.data.columnLabel is string
            && request.resource.data.columnLabel.size() > 0;
          allow delete: if false;

          match /settings/{docId} {
            allow read: if canReadTenant(tenantId);
            allow create, update: if docId == 'electricalConsumption'
              && (canEditTenantConfig(tenantId) || isOwner())
              && isValidElectricalConsumptionSettings();
            allow delete: if false;
          }

          match /runtimeEvents/{eventId} {
            allow read: if canReadTenant(tenantId);
            allow create, update, delete: if false;
          }
        }

        match /settings/{docId} {
          allow read: if canReadTenant(tenantId);
          allow create, update: if docId == 'controlDashboard'
            && (canEditTenantConfig(tenantId) || isOwner());
          allow create, update: if docId == 'electricalCost'
            && (canEditTenantConfig(tenantId) || isOwner())
            && isValidElectricalCostSettings();
          allow create: if docId == 'controlDashboard'
            && canWriteManualFanStatus(tenantId)
            && isManualFanStatusCreate();
          allow update: if docId == 'controlDashboard'
            && canWriteManualFanStatus(tenantId)
            && isManualFanStatusUpdate();
          allow create: if docId == 'controlDashboard'
            && canWriteManualFanStatus(tenantId)
            && isMaintenanceCreate();
          allow update: if docId == 'controlDashboard'
            && canWriteManualFanStatus(tenantId)
            && isMaintenanceUpdate();
          allow delete: if false;
        }

        match /doors/{doorId} {
          allow read: if canReadTenant(tenantId);
          allow create, update, delete: if false;

          match /openings/{openingId} {
            allow read: if canReadTenant(tenantId);
            allow delete: if isOwner();
            allow create, update: if false;
          }
        }

        match /room_wash_events/{eventId} {
          allow read: if canReadTenant(tenantId);
          allow create: if (isTenantMember(tenantId) || isOwner())
            && isValidRoomWashEvent(tenantId);
          allow update, delete: if false;
        }
      }

      // --- New structural schema (Sites/Sectors/Devices) ---------------
      // Sectors and Devices are brand new, tenant-level collections that
      // coexist in parallel with the legacy `sites/{siteId}/plcs/{plcId}`
      // schema above. They do not read, write, or otherwise depend on any
      // legacy PLC LOGO! document. See lib/models/agro_sector.dart and
      // lib/models/agro_device.dart.
      //
      // Same permission model as `sites` above: owner-only writes,
      // canReadTenant() for reads. siteId is immutable after creation
      // (a Sector/Device does not move between Sites). The tenant
      // provisioning service writes Site/Sectors/Devices in one transaction
      // and always sets siteId to the initial Site created in the same tenant.

      match /sectors/{sectorId} {
        allow read: if canReadTenant(tenantId);

        allow create: if isOwner()
          && request.resource.data.keys()
              .hasOnly(['siteId', 'name', 'description', 'enabled', 'createdAt', 'updatedAt'])
          && request.resource.data.keys()
              .hasAll(['siteId', 'name', 'description', 'enabled', 'createdAt', 'updatedAt'])
          && request.resource.data.siteId is string
          && request.resource.data.siteId.size() > 0
          && existsAfter(/databases/$(database)/documents/tenants/$(tenantId)/sites/$(request.resource.data.siteId))
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.description is string
          && request.resource.data.enabled is bool
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;

        allow update: if isOwner()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'description', 'enabled', 'updatedAt'])
          && request.resource.data.siteId == resource.data.siteId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && (
            !('description' in request.resource.data)
            || request.resource.data.description is string
          )
          && (
            !('enabled' in request.resource.data)
            || request.resource.data.enabled is bool
          )
          && (
            !('updatedAt' in request.resource.data)
            || request.resource.data.updatedAt is timestamp
          );

        allow delete: if false;
      }

      match /devices/{deviceId} {
        allow read: if canReadTenant(tenantId);

        allow create: if isOwner()
          && request.resource.data.keys()
              .hasOnly(['siteId', 'name', 'type', 'model', 'description', 'enabled', 'createdAt', 'updatedAt', 'sortOrder', 'snapshotUnitKey', 'sectorIds'])
          && request.resource.data.keys()
              .hasAll(['siteId', 'name', 'type', 'model', 'description', 'enabled', 'createdAt', 'updatedAt'])
          && request.resource.data.siteId is string
          && request.resource.data.siteId.size() > 0
          && existsAfter(/databases/$(database)/documents/tenants/$(tenantId)/sites/$(request.resource.data.siteId))
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.type is string
          && request.resource.data.type.size() > 0
          && request.resource.data.model is string
          && request.resource.data.description is string
          && request.resource.data.enabled is bool
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && (
            !('sortOrder' in request.resource.data)
            || request.resource.data.sortOrder is int
          )
          && (
            !('snapshotUnitKey' in request.resource.data)
            || (
              request.resource.data.snapshotUnitKey is string
              && request.resource.data.snapshotUnitKey.size() > 0
            )
          )
          && (
            !('sectorIds' in request.resource.data)
            || request.resource.data.sectorIds is list
          );

        allow update: if isOwner()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'type', 'model', 'description', 'enabled', 'updatedAt', 'sortOrder', 'snapshotUnitKey', 'sectorIds'])
          && request.resource.data.siteId == resource.data.siteId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && (
            !('type' in request.resource.data)
            || (request.resource.data.type is string && request.resource.data.type.size() > 0)
          )
          && (
            !('model' in request.resource.data)
            || request.resource.data.model is string
          )
          && (
            !('description' in request.resource.data)
            || request.resource.data.description is string
          )
          && (
            !('enabled' in request.resource.data)
            || request.resource.data.enabled is bool
          )
          && (
            !('updatedAt' in request.resource.data)
            || request.resource.data.updatedAt is timestamp
          )
          && (
            !('sortOrder' in request.resource.data)
            || request.resource.data.sortOrder is int
          )
          && (
            !('sectorIds' in request.resource.data)
            || request.resource.data.sectorIds is list
          )
          && (
            !('snapshotUnitKey' in request.resource.data)
            || (
              request.resource.data.snapshotUnitKey is string
              && request.resource.data.snapshotUnitKey.size() > 0
            )
          );

        allow delete: if false;

        match /alertConfig/{alertId} {
          allow get: if canReadAlertConfig(tenantId) && isKnownAlertId(alertId);
          allow list: if canReadAlertConfig(tenantId);
          allow create: if canCreateAlertConfig(tenantId, alertId);
          allow update: if canUpdateAlertConfig(tenantId, alertId);
          allow delete: if canDeleteAlertConfig(tenantId, alertId);
        }

        match /alertRecipients/{recipientId} {
          allow get, list: if canReadTenant(tenantId);
          allow create: if canCreateAlertRecipient(tenantId);
          allow update: if canUpdateAlertRecipient(tenantId);
          allow delete: if canDeleteAlertRecipient(tenantId);
        }

        match /pigStats/pigs {
          allow read: if canReadTenant(tenantId);
          allow create, update: if (isTenantMember(tenantId) || isOwner())
            && request.resource.data.keys().hasOnly([
              'currentCount',
              'tenantId',
              'siteId',
              'deviceId',
              'updatedAt',
              'updatedBy'
            ])
            && request.resource.data.currentCount is int
            && request.resource.data.tenantId == tenantId
            && request.resource.data.deviceId == deviceId
            && request.resource.data.siteId is string
            && request.resource.data.siteId.size() > 0
            && request.resource.data.updatedAt is timestamp
            && request.resource.data.updatedBy is string;
          allow delete: if false;
        }

        match /pigMovements/{movementId} {
          allow read: if canReadTenant(tenantId);
          allow create: if (isTenantMember(tenantId) || isOwner())
            && request.resource.data.keys().hasOnly([
              'type',
              'date',
              'quantity',
              'reasonId',
              'reasonName',
              'userId',
              'userName',
              'tenantId',
              'siteId',
              'deviceId',
              'createdAt',
              'updatedAt'
            ])
            && request.resource.data.type in ['in', 'out']
            && request.resource.data.date is timestamp
            && request.resource.data.quantity is int
            && request.resource.data.quantity > 0
            && request.resource.data.tenantId == tenantId
            && request.resource.data.deviceId == deviceId
            && request.resource.data.siteId is string
            && request.resource.data.siteId.size() > 0
            && request.resource.data.userId is string
            && request.resource.data.userName is string
            && request.resource.data.createdAt is timestamp
            && request.resource.data.updatedAt is timestamp;
          allow update, delete: if false;
        }

        // Prompt_Historicos_Temperatura_Humedad_por_Device — hourly/daily
        // temperature+humidity aggregates for this Device. Written only by
        // the backend's own Google service account (IAM-authenticated,
        // bypasses these rules entirely — same mechanism already used for
        // runtimeEvents/doors above); reads follow the same tenant scope as
        // every other subcollection here.
        match /historyHourly/{periodId} {
          allow read: if canReadTenant(tenantId);
          allow create, update, delete: if false;
        }

        match /historyDaily/{periodId} {
          allow read: if canReadTenant(tenantId);
          allow create, update, delete: if false;
        }

        match /rooms/{roomId} {
          allow read: if canReadTenant(tenantId);

          allow create: if isOwner()
            && request.resource.data.keys()
                .hasOnly(['siteId', 'name', 'enabled', 'sortOrder', 'snapshotUnitKey', 'createdAt', 'updatedAt'])
            && request.resource.data.keys()
                .hasAll(['siteId', 'name', 'enabled', 'createdAt', 'updatedAt'])
            && existsAfter(/databases/$(database)/documents/tenants/$(tenantId)/devices/$(deviceId))
            && request.resource.data.siteId is string
            && request.resource.data.siteId.size() > 0
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.enabled is bool
            && request.resource.data.createdAt is timestamp
            && request.resource.data.updatedAt is timestamp
            && (
              !('sortOrder' in request.resource.data)
              || request.resource.data.sortOrder is int
            )
            && (
              !('snapshotUnitKey' in request.resource.data)
              || (
                request.resource.data.snapshotUnitKey is string
                && request.resource.data.snapshotUnitKey.size() > 0
              )
            );

          allow update: if isOwner()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['name', 'enabled', 'sortOrder', 'snapshotUnitKey', 'updatedAt'])
            && request.resource.data.siteId == resource.data.siteId
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && (
              !('enabled' in request.resource.data)
              || request.resource.data.enabled is bool
            )
            && (
              !('updatedAt' in request.resource.data)
              || request.resource.data.updatedAt is timestamp
            )
            && (
              !('sortOrder' in request.resource.data)
              || request.resource.data.sortOrder is int
            )
            && (
              !('snapshotUnitKey' in request.resource.data)
              || (
                request.resource.data.snapshotUnitKey is string
                && request.resource.data.snapshotUnitKey.size() > 0
              )
            );

          allow delete: if false;

          match /alertConfig/{alertId} {
            allow get: if canReadAlertConfig(tenantId) && isKnownAlertId(alertId);
            allow list: if canReadAlertConfig(tenantId);
            allow create: if canCreateAlertConfig(tenantId, alertId);
            allow update: if canUpdateAlertConfig(tenantId, alertId);
            allow delete: if canDeleteAlertConfig(tenantId, alertId);
          }

          match /alertRecipients/{recipientId} {
            allow get, list: if canReadTenant(tenantId);
            allow create: if canCreateAlertRecipient(tenantId);
            allow update: if canUpdateAlertRecipient(tenantId);
            allow delete: if canDeleteAlertRecipient(tenantId);
          }

          match /pigStats/pigs {
            allow read: if canReadTenant(tenantId);
            allow create, update: if (isTenantMember(tenantId) || isOwner())
              && request.resource.data.keys().hasOnly([
                'currentCount',
                'tenantId',
                'siteId',
                'deviceId',
                'roomId',
                'updatedAt',
                'updatedBy'
              ])
              && request.resource.data.currentCount is int
              && request.resource.data.tenantId == tenantId
              && request.resource.data.deviceId == deviceId
              && request.resource.data.roomId == roomId
              && request.resource.data.siteId is string
              && request.resource.data.siteId.size() > 0
              && request.resource.data.updatedAt is timestamp
              && request.resource.data.updatedBy is string;
            allow delete: if false;
          }

          match /pigMovements/{movementId} {
            allow read: if canReadTenant(tenantId);
            allow create: if (isTenantMember(tenantId) || isOwner())
              && request.resource.data.keys().hasOnly([
                'type',
                'date',
                'quantity',
                'reasonId',
                'reasonName',
                'userId',
                'userName',
                'tenantId',
                'siteId',
                'deviceId',
                'roomId',
                'createdAt',
                'updatedAt'
              ])
              && request.resource.data.type in ['in', 'out']
              && request.resource.data.date is timestamp
              && request.resource.data.quantity is int
              && request.resource.data.quantity > 0
              && request.resource.data.tenantId == tenantId
              && request.resource.data.deviceId == deviceId
              && request.resource.data.roomId == roomId
              && request.resource.data.siteId is string
              && request.resource.data.siteId.size() > 0
              && request.resource.data.userId is string
              && request.resource.data.userName is string
              && request.resource.data.createdAt is timestamp
              && request.resource.data.updatedAt is timestamp;
            allow update, delete: if false;
          }
        }

      }
    }

    match /tenants/{tenantId}/sites/{siteId}/plcs/{plcId}/metrics/temperature {
      allow read: if canReadTenant(tenantId);
      allow create, update, delete: if false;

      match /hourly/{docId} {
        allow read: if canReadTenant(tenantId);
        allow create, update, delete: if false;
      }

      match /daily/{docId} {
        allow read: if canReadTenant(tenantId);
        allow create, update, delete: if false;
      }
    }

    match /tenants/{tenantId}/sites/{siteId}/plcs/{plcId}/metrics/differentialPressure {
      allow read: if canReadTenant(tenantId);
      allow create, update, delete: if false;

      match /daily/{docId} {
        allow read: if canReadTenant(tenantId);
        allow create, update, delete: if false;
      }
    }

    match /tenants/{tenantId}/sites/{siteId}/plcs/{plcId}/metrics/waterShortage {
      allow read: if canReadTenant(tenantId);
      allow create, update: if isTenantMember(tenantId) || isOwner();
      allow delete: if false;

      match /events/{eventId} {
        allow read: if canReadTenant(tenantId);
        allow create: if isTenantMember(tenantId) || isOwner();
        allow update, delete: if false;
      }

      match /monthly/{monthKey} {
        allow read: if canReadTenant(tenantId);
        allow create, update: if isTenantMember(tenantId) || isOwner();
        allow delete: if false;
      }
    }

    // Pig tracking: stock aggregated count updated atomically via client transaction.
    match /tenants/{tenantId}/sites/{siteId}/plcs/{plcId}/plcStats/pigs {
      allow read: if canReadTenant(tenantId);
      allow create, update: if isTenantMember(tenantId) || isOwner();
      allow delete: if false;
    }

    // Pig movement log — immutable once created.
    match /tenants/{tenantId}/sites/{siteId}/plcs/{plcId}/pigMovements/{movementId} {
      allow read: if canReadTenant(tenantId);
      allow create: if isTenantMember(tenantId) || isOwner();
      allow update, delete: if false;
    }

    // Pig exit reasons — shared across all PLCs of the site, never deleted.
    match /tenants/{tenantId}/sites/{siteId}/pigExitReasons/{reasonId} {
      allow read: if canReadTenant(tenantId);
      allow create: if isTenantMember(tenantId) || isOwner();
      allow update, delete: if false;
    }

    // Etapa N7.1 §3/§8/§9/§16: the Device's own board configuration — its
    // assigned `capabilityProfileId` plus its independent
    // BoardContentLayout (schema-2), including `sourceBoardPresetId`/
    // `sourceBoardPresetVersion` trazability only (never a live reference:
    // editing/deleting a `boardPresets` document never touches this one).
    // Read: any tenant member/owner/Valke technician, same as every other
    // Device-scoped collection. N7.1.1 keeps the feature owner-only in both
    // UI and Rules; tenant_admin is intentionally denied until a complete
    // tenant-scoped administration surface is introduced.
    //
    // A fully-qualified top-level `match` (Firestore Rules supports
    // multi-segment match paths regardless of textual position in the
    // file; rule evaluation is never order-dependent), placed at the very
    // end of this file rather than grouped with N7.1's other new
    // collections or physically nested inside the core devices
    // collection's own match block: several existing regression tests
    // (`test/tenant_management_page_test.dart`,
    // `test/agro_structural_schema_test.dart`) locate OTHER collections'
    // rule text via plain, order-dependent substring search (the first/
    // next occurrence of a literal path in the file) — this block's own
    // path happens to share a textual prefix with two of those anchors,
    // so placing it anywhere before them risks becoming the match those
    // searches find instead of the real one. Anchoring it after every
    // other `match` in the file sidesteps that category of collision
    // entirely, without touching any pre-existing test.
    //
    // `items`' internal shape (each entry's `id`/`type`/`placement`/
    // `content` keys, and every content-type variant's own fields) is
    // deliberately NOT re-validated field-by-field here — Firestore Rules
    // has no supported per-element list predicate for this, and that shape
    // is already enforced client-side by `BoardContentItem.fromMap`'s
    // throwing constructor (never reachable without going through it
    // first) and by `BoardContentValidator` before an apply/save is ever
    // attempted (N7.1 §8/§11). Rules here focus on what actually needs
    // server-side enforcement: tenant scoping, role, and the top-level
    // document shape.
    // Allows the owner-only aggregate collection-group count used before a
    // BoardPreset delete. The query filters by sourceBoardPresetId and reads
    // no documents; tenant roles do not receive this cross-tenant access.
    match /{parentPath=**}/settings/{settingId} {
      allow read: if isOwner();
    }

    match /tenants/{tenantId}/devices/{deviceId}/settings/boardConfig {
      function isValidBoardConfigDocument() {
        return request.resource.data.keys().hasOnly([
            'deviceId', 'layoutTemplateId', 'showTitle', 'titleOverride',
            'schemaVersion', 'layoutVersion', 'items', 'createdAt',
            'updatedAt', 'capabilityProfileId', 'sourceBoardPresetId',
            'sourceBoardPresetVersion'
          ])
          && request.resource.data.keys().hasAll([
            'deviceId', 'layoutTemplateId', 'schemaVersion',
            'layoutVersion', 'items', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.deviceId == deviceId
          && request.resource.data.layoutTemplateId is string
          && request.resource.data.layoutTemplateId.size() > 0
          && request.resource.data.schemaVersion is int
          && request.resource.data.layoutVersion is int
          && request.resource.data.layoutVersion > 0
          && request.resource.data.items is list
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && (
            !('showTitle' in request.resource.data)
            || request.resource.data.showTitle is bool
          )
          && (
            !('titleOverride' in request.resource.data)
            || request.resource.data.titleOverride == null
            || (request.resource.data.titleOverride is string
                && request.resource.data.titleOverride.size() > 0)
          )
          && (
            !('capabilityProfileId' in request.resource.data)
            || request.resource.data.capabilityProfileId == null
            || request.resource.data.capabilityProfileId is string
          )
          && (
            !('sourceBoardPresetId' in request.resource.data)
            || request.resource.data.sourceBoardPresetId == null
            || request.resource.data.sourceBoardPresetId is string
          )
          && (
            !('sourceBoardPresetVersion' in request.resource.data)
            || request.resource.data.sourceBoardPresetVersion == null
            || request.resource.data.sourceBoardPresetVersion is int
          );
      }

      allow read: if canReadTenant(tenantId);
      allow create, update: if isOwner()
        && isValidBoardConfigDocument();
      allow delete: if false;
    }
  }
}
